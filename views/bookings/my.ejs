<% layout('layouts/boilerplate') %>

<div class="page-heading">
    <div class="page-heading-header">
        <div>
            <h1>My Shifts & Work Passport</h1>
            <p class="muted mb-0">Your accepted, active, and completed PeakShift work opportunities.</p>
        </div>
        <div class="d-flex gap-2">
            <a class="btn btn-secondary" href="/earnings"><i class="fa-solid fa-wallet me-1 text-primary"></i> My Earnings</a>
            <a class="btn btn-primary" href="/listings"><i class="fa-solid fa-briefcase me-1"></i> Find a Shift</a>
        </div>
    </div>
</div>

<% if (bookings && bookings.length > 0) { %>
    <div class="booking-list">
        <% bookings.forEach(booking => { %>
            <article class="booking-card">
                <div class="booking-card-body">
                    <div class="booking-card-head">
                        <div>
                            <h2>
                                <% if (booking.listing) { %>
                                    <a href="/listings/<%= booking.listing._id %>"><%= booking.listing.title %></a>
                                <% } else { %>
                                    Shift unavailable
                                <% } %>
                            </h2>
                            <% if (booking.listing) { %>
                                <p class="muted"><i class="fa-solid fa-location-dot"></i> <%= booking.listing.location %></p>
                            <% } %>
                        </div>
                        <div>
                            <%- include('../includes/status-badge', { status: booking.status }) %>
                        </div>
                    </div>

                    <div class="booking-facts">
                        <span><i class="fa-solid fa-clock"></i> <%= timeHelpers.formatShiftRangeIST(booking.startAt, booking.endAt) %></span>
                        <span><i class="fa-solid fa-business-time"></i> <%= booking.hours %> hour<%= booking.hours !== 1 ? "s" : "" %></span>
                        <span><i class="fa-solid fa-indian-rupee-sign"></i> Payout: &#8377; <%= booking.payAmount.toLocaleString('en-IN') %></span>
                    </div>

                    <!-- Check-in details if checked in -->
                    <% if (booking.checkInAt) { %>
                        <div class="p-2 my-2 small border rounded" style="background:var(--surface-muted, rgba(0,0,0,0.02));">
                            <span class="text-success fw-bold"><i class="fa-solid fa-circle-check me-1"></i> Checked in at <%= timeHelpers.formatIST(booking.checkInAt) %></span>
                            <% if (booking.checkInDistanceM != null) { %>
                                <span class="text-muted ms-2">(<%= booking.checkInDistanceM %>m from shift location)</span>
                            <% } %>
                        </div>
                    <% } %>

                    <!-- Actions -->
                    <div class="d-flex flex-wrap align-items-center gap-2 mt-3">
                        <% if (booking.status === "accepted") { %>
                            <!-- Check in button triggers modal -->
                            <button
                                type="button"
                                class="btn btn-primary btn-sm checkin-trigger-btn"
                                data-bs-toggle="modal"
                                data-bs-target="#checkInModal-<%= booking._id %>"
                                data-booking-id="<%= booking._id %>"
                            >
                                <i class="fa-solid fa-camera me-1"></i> Check In
                            </button>

                            <!-- Cancel shift allowed before start -->
                            <% if (booking.startAt > new Date()) { %>
                                <form method="POST" action="/bookings/<%= booking._id %>?_method=DELETE" class="mb-0">
                                    <button class="btn danger small" type="submit">Cancel Shift</button>
                                </form>
                            <% } %>

                            <!-- Check In Modal -->
                            <div class="modal fade" id="checkInModal-<%= booking._id %>" tabindex="-1" aria-labelledby="checkInModalLabel-<%= booking._id %>" aria-hidden="true">
                                <div class="modal-dialog">
                                    <div class="modal-content">
                                        <form method="POST" action="/bookings/<%= booking._id %>/checkin" enctype="multipart/form-data" class="needs-validation checkin-form" novalidate>
                                            <div class="modal-header">
                                                <h5 class="modal-title" id="checkInModalLabel-<%= booking._id %>">Worker Shift Check-In</h5>
                                                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                            </div>
                                            <div class="modal-body">
                                                <p class="small text-muted mb-3">
                                                    Check in requires a selfie photo and your live GPS location within <%= config.CHECKIN_RADIUS_M || 300 %> meters of the shift location.
                                                </p>

                                                <div class="mb-3">
                                                    <label for="selfie-<%= booking._id %>" class="form-label fw-bold">Upload Selfie Photo (Max 5MB)</label>
                                                    <input type="file" id="selfie-<%= booking._id %>" name="selfie" class="form-control" accept="image/png, image/jpeg" required>
                                                    <div class="invalid-feedback">Please choose a selfie image.</div>
                                                </div>

                                                <div class="p-2 mb-2 rounded bg-light small">
                                                    <i class="fa-solid fa-location-dot text-primary me-1"></i>
                                                    <span id="geo-status-<%= booking._id %>">Detecting your location...</span>
                                                </div>

                                                <!-- Hidden coordinates -->
                                                <input type="hidden" id="lat-<%= booking._id %>" name="lat">
                                                <input type="hidden" id="lng-<%= booking._id %>" name="lng">
                                            </div>
                                            <div class="modal-footer">
                                                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                                                <button type="submit" class="btn btn-primary" id="submit-btn-<%= booking._id %>">
                                                    Confirm Check-In
                                                </button>
                                            </div>
                                        </form>
                                    </div>
                                </div>
                            </div>
                        <% } else if (booking.status === "checked_in") { %>
                            <span class="text-primary small fw-bold">
                                <i class="fa-solid fa-person-digging me-1"></i> Shift in progress. Payout will be processed after <%= timeHelpers.formatTimeIST(booking.endAt) %>.
                            </span>
                        <% } else if (booking.status === "completed") { %>
                            <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 w-100">
                                <span class="text-success small fw-bold">
                                    <i class="fa-solid fa-circle-check me-1"></i> Completed &bull; Simulated payout processed.
                                    <a href="/earnings" class="ms-1 text-decoration-underline">View in Earnings</a>
                                </span>
                                <div>
                                    <% if (typeof reviewedBookingIds !== 'undefined' && reviewedBookingIds.has(booking._id.toString())) { %>
                                        <span class="badge bg-light text-muted border">
                                            <i class="fa-solid fa-star text-warning me-1"></i>Rated
                                        </span>
                                    <% } else { %>
                                        <button class="btn btn-sm btn-outline-primary" data-bs-toggle="modal" data-bs-target="#rateShiftModal-<%= booking._id %>">
                                            <i class="fa-solid fa-star text-warning me-1"></i>Rate this shift
                                        </button>

                                        <!-- Modal for worker to rate the shift / business -->
                                        <div class="modal fade text-start" id="rateShiftModal-<%= booking._id %>" tabindex="-1" aria-labelledby="rateShiftModalLabel-<%= booking._id %>" aria-hidden="true">
                                            <div class="modal-dialog">
                                                <div class="modal-content">
                                                    <form method="POST" action="/bookings/<%= booking._id %>/reviews" class="needs-validation" novalidate>
                                                        <div class="modal-header">
                                                            <h5 class="modal-title" id="rateShiftModalLabel-<%= booking._id %>">Rate this shift</h5>
                                                            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                                        </div>
                                                        <div class="modal-body">
                                                            <p class="small text-muted mb-2">Shift: <strong><%= booking.listing ? booking.listing.title : "Shift" %></strong></p>
                                                            <% if (booking.listing && booking.listing.owner) { %>
                                                                <p class="small text-muted mb-3">Business: <strong><%= booking.listing.owner.businessName || booking.listing.owner.username %></strong></p>
                                                            <% } %>
                                                            <div class="mb-3">
                                                                <label class="form-label fw-bold">Rating</label>
                                                                <select name="review[rating]" class="form-select" required>
                                                                    <option value="">Select rating (1 to 5)...</option>
                                                                    <option value="5">★★★★★ - 5 (Excellent)</option>
                                                                    <option value="4">★★★★☆ - 4 (Good)</option>
                                                                    <option value="3">★★★☆☆ - 3 (Average)</option>
                                                                    <option value="2">★★☆☆☆ - 2 (Below Average)</option>
                                                                    <option value="1">★☆☆☆☆ - 1 (Poor)</option>
                                                                </select>
                                                                <div class="invalid-feedback">Please select a rating.</div>
                                                            </div>
                                                            <div class="mb-3">
                                                                <label class="form-label fw-bold">Comment (optional)</label>
                                                                <textarea name="review[comment]" class="form-control" rows="3" placeholder="Share your experience working this shift..."></textarea>
                                                            </div>
                                                        </div>
                                                        <div class="modal-footer">
                                                            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                                                            <button type="submit" class="btn btn-primary">Submit Rating</button>
                                                        </div>
                                                    </form>
                                                </div>
                                            </div>
                                        </div>
                                    <% } %>
                                </div>
                            </div>
                        <% } else if (booking.status === "no_show") { %>
                            <span class="text-danger small">
                                <i class="fa-solid fa-circle-xmark me-1"></i> Shift marked as no-show (no check-in recorded).
                            </span>
                        <% } %>
                    </div>
                </div>
            </article>
        <% }) %>
    </div>
<% } else { %>
    <%- include('../includes/empty-state', {
        icon: 'fa-solid fa-calendar-xmark',
        title: 'No shifts accepted yet',
        message: 'You have not accepted any shifts yet. Explore open shifts nearby to start earning!',
        actionText: 'Explore open shifts',
        actionLink: '/listings'
    }) %>
<% } %>

<script>
  // Acquire geolocation automatically when check-in modal is shown
  document.querySelectorAll('.checkin-trigger-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      const bookingId = btn.getAttribute('data-booking-id');
      const statusEl = document.getElementById(`geo-status-${bookingId}`);
      const latEl = document.getElementById(`lat-${bookingId}`);
      const lngEl = document.getElementById(`lng-${bookingId}`);
      const submitBtn = document.getElementById(`submit-btn-${bookingId}`);

      if (navigator.geolocation) {
        statusEl.innerHTML = '<i class="fa-solid fa-spinner fa-spin me-1"></i> Fetching your live GPS location...';
        navigator.geolocation.getCurrentPosition(
          (pos) => {
            latEl.value = pos.coords.latitude;
            lngEl.value = pos.coords.longitude;
            statusEl.innerHTML = '<i class="fa-solid fa-check text-success me-1"></i> Location captured successfully!';
            statusEl.classList.add('text-success');
          },
          (err) => {
            statusEl.innerHTML = '<i class="fa-solid fa-triangle-exclamation text-danger me-1"></i> Location permission denied. Check-in requires location access.';
            statusEl.classList.add('text-danger');
          },
          { timeout: 8000 }
        );
      } else {
        statusEl.innerHTML = '<i class="fa-solid fa-triangle-exclamation text-danger me-1"></i> Geolocation is not supported by your browser.';
      }
    });
  });

  // Double-click safety on check-in forms
  document.querySelectorAll('.checkin-form').forEach(form => {
    form.addEventListener('submit', function (e) {
      if (!this.checkValidity()) return;
      const btn = this.querySelector('button[type="submit"]');
      if (btn) {
        btn.disabled = true;
        btn.innerHTML = '<i class="fa-solid fa-spinner fa-spin me-1"></i> Checking in...';
      }
    });
  });
</script>
