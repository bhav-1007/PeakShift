<section class="booking-panel" style="background:var(--surface); border:1px solid var(--line); border-radius:var(--radius-lg); padding:24px; box-shadow:var(--shadow-sm);">
    <div class="d-flex justify-content-between align-items-center mb-2">
        <h3 style="font-size:1.2rem; font-weight:800; margin:0;">
            <i class="fa-solid fa-clipboard-check text-primary me-2"></i>Accept Shift
        </h3>
        <% const slotsLeft = Math.max(0, listing.workersNeeded - listing.filledCount); %>
        <% if (slotsLeft > 0 && listing.status === 'open' && listing.startAt > new Date()) { %>
            <span class="badge bg-success-subtle text-success-emphasis border" style="font-size:0.75rem;">
                <i class="fa-solid fa-bolt me-1"></i><%= slotsLeft %> slot<%= slotsLeft !== 1 ? 's' : '' %> available
            </span>
        <% } %>
    </div>

    <p class="muted small mb-3">
        &#8377; <%= listing.price.toLocaleString('en-IN') %> / hr &bull; <%= listing.filledCount %> of <%= listing.workersNeeded %> slots filled
    </p>

    <% if (!currentUser) { %>
        <div class="p-3 rounded bg-light border text-center">
            <p class="muted small mb-2">Sign in with a verified worker account to accept this shift.</p>
            <a class="btn btn-primary w-100" href="/login">
                <i class="fa-solid fa-right-to-bracket me-1"></i> Login to Accept
            </a>
        </div>
    <% } else if (currentUser.role === 'business') { %>
        <div class="p-3 rounded bg-light border">
            <p class="muted small mb-0">
                <i class="fa-solid fa-building-circle-check text-primary me-1"></i> <strong>Business Account:</strong> Only workers can accept shifts. Use your business dashboard to manage incoming worker applications.
            </p>
        </div>
    <% } else if (listing.status !== 'open' || listing.startAt <= new Date()) { %>
        <div class="alert alert-secondary mb-0 small">
            <i class="fa-solid fa-circle-info me-1"></i> This shift is <%= listing.status === 'filled' ? 'fully staffed' : (listing.status === 'cancelled' ? 'cancelled' : 'no longer open for acceptance') %>.
        </div>
    <% } else { %>
        <% 
            const shiftHours = timeHelpers.calculateHours(listing.startAt, listing.endAt);
            const estPayout = shiftHours * listing.price;
        %>
        <div class="p-3 mb-3 rounded" style="background:var(--brand-light); border:1px solid rgba(37,99,235,0.18);">
            <div class="d-flex justify-content-between align-items-center mb-1">
                <span class="small text-muted font-monospace">ESTIMATED PAYOUT</span>
                <span class="small text-muted"><%= shiftHours %> hours</span>
            </div>
            <div class="d-flex align-items-baseline gap-2">
                <span style="font-size:1.6rem; font-weight:800; color:var(--brand);">&#8377; <%= estPayout.toLocaleString('en-IN') %></span>
                <span class="small text-muted">(Simulated payout on completion)</span>
            </div>
        </div>

        <form method="POST" action="/listings/<%= listing._id %>/bookings" class="booking-form mb-0">
            <button class="btn btn-primary w-100" type="submit" style="min-height:48px; font-size:1rem;">
                <i class="fa-solid fa-calendar-check me-2"></i> Accept Shift Now
            </button>
            <p class="text-center text-muted small mt-2 mb-0" style="font-size:0.75rem;">
                <i class="fa-solid fa-shield-halved text-success me-1"></i> Free cancellation anytime before shift starts
            </p>
        </form>
    <% } %>
</section>
