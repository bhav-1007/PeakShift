<% layout('layouts/boilerplate') %>

<div class="page-heading">
    <div class="page-heading-header">
        <div>
            <h1>Business Operations Dashboard</h1>
            <p class="muted mb-0">Monitor shift staffing, live worker check-ins, and shift completion payouts.</p>
        </div>
        <div class="d-flex gap-2">
            <a class="btn btn-secondary" href="/spend"><i class="fa-solid fa-receipt me-1 text-primary"></i> Shift Spend</a>
            <a class="btn btn-primary" href="/listings/new"><i class="fa-solid fa-plus me-1"></i> Post Shift</a>
        </div>
    </div>
</div>

<section class="stats-grid mb-4">
    <div class="stat-card">
        <div class="d-flex justify-content-between align-items-center">
            <span>Total Shifts</span>
            <i class="fa-solid fa-calendar-days text-primary"></i>
        </div>
        <strong><%= stats.totalListings %></strong>
    </div>
    <div class="stat-card">
        <div class="d-flex justify-content-between align-items-center">
            <span>Worker Bookings</span>
            <i class="fa-solid fa-users text-primary"></i>
        </div>
        <strong><%= stats.totalBookings %></strong>
    </div>
    <div class="stat-card">
        <div class="d-flex justify-content-between align-items-center">
            <span>Checked In</span>
            <i class="fa-solid fa-camera" style="color:var(--accent-teal, #0d9488);"></i>
        </div>
        <strong style="color:var(--accent-teal, #0d9488);"><%= stats.checkedInWorkers %></strong>
    </div>
    <div class="stat-card">
        <div class="d-flex justify-content-between align-items-center">
            <span>Completed Payouts</span>
            <i class="fa-solid fa-circle-check" style="color:var(--accent-coral, #f43f5e);"></i>
        </div>
        <strong style="color:var(--accent-coral, #f43f5e);"><%= stats.completedWorkers %></strong>
    </div>
</section>

<section class="dashboard-section">
    <div class="section-heading mb-3">
        <h2>Shift Roster & Worker Check-ins</h2>
        <span class="badge bg-light text-dark border">Simulated payout workflow</span>
    </div>

    <% if (myListings && myListings.length > 0) { %>
        <% myListings.forEach(listing => { %>
            <div class="card mb-4" style="background:var(--surface); border:1px solid var(--line); border-radius:var(--radius-lg); overflow:hidden;">
                <div class="card-header d-flex flex-wrap justify-content-between align-items-center gap-2 p-3" style="background:var(--surface-muted, rgba(0,0,0,0.02)); border-bottom:1px solid var(--line);">
                    <div>
                        <h3 class="mb-1" style="font-size:1.15rem;">
                            <a href="/listings/<%= listing._id %>"><%= listing.title %></a>
                        </h3>
                        <p class="muted small mb-0">
                            <i class="fa-solid fa-clock me-1"></i> <%= timeHelpers.formatShiftRangeIST(listing.startAt, listing.endAt) %>
                            &bull; <i class="fa-solid fa-location-dot me-1"></i> <%= listing.location %>
                            &bull; <span class="fw-bold">&#8377; <%= listing.price %> / hr</span>
                        </p>
                    </div>
                    <div class="d-flex align-items-center gap-2">
                        <span class="badge <%= listing.status === 'open' ? 'bg-success' : (listing.status === 'filled' ? 'bg-primary' : 'bg-secondary') %>">
                            <%= listing.status.toUpperCase() %>
                        </span>
                        <%
                            const hasCheckedIn = listing.roster.some(b => b.status === 'checked_in');
                            const isPastEnd = now >= listing.endAt;
                        %>
                        <% if (hasCheckedIn && isPastEnd) { %>
                            <form method="POST" action="/listings/<%= listing._id %>/complete-all" class="needs-safe-submit mb-0">
                                <button class="btn btn-sm btn-success" type="submit">
                                    <i class="fa-solid fa-check-double me-1"></i> Complete all (Simulated payout)
                                </button>
                            </form>
                        <% } %>
                    </div>
                </div>

                <div class="card-body p-0">
                    <% if (listing.roster && listing.roster.length > 0) { %>
                        <div class="table-responsive">
                            <table class="table mb-0 align-middle">
                                <thead class="table-light">
                                    <tr>
                                        <th style="padding-left:16px;">Worker</th>
                                        <th>Status</th>
                                        <th>Check-in Time</th>
                                        <th>Distance</th>
                                        <th>Selfie</th>
                                        <th>Pay Amount</th>
                                        <th style="padding-right:16px; text-align:right;">Action</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <% listing.roster.forEach(b => { %>
                                        <tr>
                                            <td style="padding-left:16px;">
                                                <strong><%= b.worker ? b.worker.username : "Worker" %></strong>
                                                <% if (b.worker && b.worker.phone) { %>
                                                    <span class="d-block small text-muted"><%= b.worker.phone %></span>
                                                <% } %>
                                                <% if (b.worker) { %>
                                                    <div class="mt-1 d-flex flex-wrap gap-1 align-items-center">
                                                        <span class="badge bg-light text-dark border" title="Worker Trust Score">
                                                            <i class="fa-solid fa-shield-halved text-primary me-1"></i>Trust: <strong><%= b.worker.trustScore != null ? b.worker.trustScore : 70 %></strong>/100
                                                        </span>
                                                        <span class="badge bg-light text-dark border" title="Worker Rating">
                                                            <i class="fa-solid fa-star text-warning me-1"></i><%= b.worker.ratingCount > 0 ? b.worker.ratingAvg.toFixed(1) : "New" %><% if (b.worker.ratingCount > 0) { %> (<%= b.worker.ratingCount %>)<% } %>
                                                        </span>
                                                    </div>
                                                <% } %>
                                            </td>
                                            <td>
                                                <%- include('../includes/status-badge', { status: b.status }) %>
                                            </td>
                                            <td>
                                                <%= b.checkInAt ? timeHelpers.formatIST(b.checkInAt) : "—" %>
                                            </td>
                                            <td>
                                                <%= b.checkInDistanceM != null ? (b.checkInDistanceM + " m away") : "—" %>
                                            </td>
                                            <td>
                                                <% if (b.checkInSelfie && b.checkInSelfie.url) { %>
                                                    <a href="<%= b.checkInSelfie.url %>" target="_blank" title="View selfie">
                                                        <img src="<%= b.checkInSelfie.url %>" alt="Selfie" style="width:40px; height:40px; border-radius:50%; object-fit:cover; border:2px solid var(--line);">
                                                    </a>
                                                <% } else { %>
                                                    <span class="text-muted">—</span>
                                                <% } %>
                                            </td>
                                            <td>
                                                &#8377; <%= b.payAmount.toLocaleString('en-IN') %>
                                            </td>
                                            <td style="padding-right:16px; text-align:right;">
                                                <% if (b.status === 'checked_in') { %>
                                                    <% if (now >= b.endAt) { %>
                                                        <form method="POST" action="/bookings/<%= b._id %>/complete" class="needs-safe-submit d-inline mb-0">
                                                            <button class="btn btn-sm btn-success" type="submit">
                                                                <i class="fa-solid fa-check me-1"></i> Mark completed (Simulated payout)
                                                            </button>
                                                        </form>
                                                    <% } else { %>
                                                        <span class="badge bg-light text-muted border">
                                                            Completable after <%= timeHelpers.formatTimeIST(b.endAt) %>
                                                        </span>
                                                    <% } %>
                                                <% } else if (b.status === 'completed') { %>
                                                    <div class="d-inline-flex flex-column align-items-end gap-1">
                                                        <span class="text-success small fw-bold">
                                                            <i class="fa-solid fa-circle-check me-1"></i> Simulated payout
                                                        </span>
                                                        <% if (typeof reviewedBookingIds !== 'undefined' && reviewedBookingIds.has(b._id.toString())) { %>
                                                            <span class="badge bg-light text-muted border">
                                                                <i class="fa-solid fa-star text-warning me-1"></i>Rated
                                                            </span>
                                                        <% } else { %>
                                                            <button class="btn btn-sm btn-outline-primary" data-bs-toggle="modal" data-bs-target="#rateWorkerModal-<%= b._id %>">
                                                                <i class="fa-solid fa-star text-warning me-1"></i>Rate worker
                                                            </button>

                                                            <!-- Modal for rating worker -->
                                                            <div class="modal fade text-start" id="rateWorkerModal-<%= b._id %>" tabindex="-1" aria-labelledby="rateWorkerModalLabel-<%= b._id %>" aria-hidden="true">
                                                                <div class="modal-dialog">
                                                                    <div class="modal-content">
                                                                        <form method="POST" action="/bookings/<%= b._id %>/reviews" class="needs-validation" novalidate>
                                                                            <div class="modal-header">
                                                                                <h5 class="modal-title" id="rateWorkerModalLabel-<%= b._id %>">Rate <%= b.worker ? b.worker.username : "Worker" %></h5>
                                                                                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                                                            </div>
                                                                            <div class="modal-body">
                                                                                <p class="small text-muted mb-3">Shift: <strong><%= listing.title %></strong></p>
                                                                                <div class="mb-3">
                                                                                    <label class="form-label fw-bold">Rating</label>
                                                                                    <select name="review[rating]" class="form-select" required>
                                                                                        <option value="">Select rating (1 to 5)...</option>
                                                                                        <option value="5">★★★★★ - 5 (Excellent)</option>
                                                                                        <option value="4">★★★★☆ - 4 (Good)</option>
                                                                                        <option value="3">★★★☆☆ - 3 (Average)</option>
                                                                                        <option value="2">★★☆☆☆ - 2 (Below Average)</option>
                                                                                        <option value="1">★☆☆☆☆ - 1 (Poor)</option>
                                                                                    </select>
                                                                                    <div class="invalid-feedback">Please select a rating.</div>
                                                                                </div>
                                                                                <div class="mb-3">
                                                                                    <label class="form-label fw-bold">Comment (optional)</label>
                                                                                    <textarea name="review[comment]" class="form-control" rows="3" placeholder="Share how this worker performed..."></textarea>
                                                                                </div>
                                                                            </div>
                                                                            <div class="modal-footer">
                                                                                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                                                                                <button type="submit" class="btn btn-primary">Submit Rating</button>
                                                                            </div>
                                                                        </form>
                                                                    </div>
                                                                </div>
                                                            </div>
                                                        <% } %>
                                                    </div>
                                                <% } else { %>
                                                    <span class="text-muted small">—</span>
                                                <% } %>
                                            </td>
                                        </tr>
                                    <% }) %>
                                </tbody>
                            </table>
                        </div>
                    <% } else { %>
                        <div class="p-3 text-muted small">No workers have accepted slots for this shift yet.</div>
                    <% } %>
                </div>
            </div>
        <% }) %>
    <% } else { %>
        <%- include('../includes/empty-state', {
            icon: 'fa-solid fa-briefcase',
            title: 'No shifts posted yet',
            message: 'You have not posted any shifts yet. Create your first shift to find verified workers for peak hours.',
            actionText: 'Post a shift',
            actionLink: '/listings/new'
        }) %>
    <% } %>
</section>

<script>
  // Prevent double-clicks on submit buttons
  document.querySelectorAll('form.needs-safe-submit').forEach(form => {
    form.addEventListener('submit', function() {
      const btn = this.querySelector('button[type="submit"]');
      if (btn) {
        btn.disabled = true;
        btn.innerHTML = '<i class="fa-solid fa-spinner fa-spin me-1"></i> Processing...';
      }
    });
  });
</script>
