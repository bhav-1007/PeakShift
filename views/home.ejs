<% layout('layouts/boilerplate') %>

<section class="pw-section pw-hero">
  <div class="pw-hero-copy">
    <p class="pw-eyebrow">Real-time staffing for peak-hour demand</p>
    <h1 class="pw-heading pw-hero-title">Making labor as flexible as demand itself.</h1>
    <p class="pw-hero-subtitle">PeakShift connects businesses that need extra hands for 2-4 hour rushes with verified workers looking for flexible earning opportunities.</p>
    <div class="pw-hero-actions">
      <a class="pw-btn pw-btn-primary pw-btn-lg" href="/listings">Find Open Shifts</a>
      <a class="pw-btn pw-btn-ghost pw-btn-lg" href="/listings/new">Post a Shift</a>
    </div>
  </div>

  <div class="pw-hero-panel" aria-label="Live staffing preview">
    <div class="pw-live-card">
      <span class="pw-status-pill"><span class="pw-status-dot"></span>Live match</span>
      <h2>Cloud kitchen dinner rush</h2>
      <p class="muted">2 packers and 1 helper needed from 7 PM&ndash;10 PM near Indiranagar.</p>
      <div class="pw-shift-metrics">
        <div><strong>15</strong><span>matched workers</span></div>
        <div><strong>3 km</strong><span>radius</span></div>
        <div><strong>&#8377;150</strong><span>per hour</span></div>
      </div>
    </div>
  </div>
</section>

<% if (stats) { %>
<section class="pw-stats-bar">
  <div class="pw-stats-inner">
    <div class="pw-stat">
      <span class="pw-stat-num"><%= stats.openShifts %>+</span>
      <span class="pw-stat-label">Open shifts</span>
    </div>
    <div class="pw-stat">
      <span class="pw-stat-num">&#8377;<%= stats.avgPay %></span>
      <span class="pw-stat-label">Avg. pay / hour</span>
    </div>
    <div class="pw-stat">
      <span class="pw-stat-num"><%= stats.cities %></span>
      <span class="pw-stat-label">Areas covered</span>
    </div>
  </div>
</section>
<% } %>

<section class="pw-section">
  <div class="pw-section-heading-inline">
    <h2 class="pw-heading pw-heading-sm">Open Peak Shifts</h2>
    <a class="pw-text-link" href="/listings">Browse all &rarr;</a>
  </div>

  <% if (featuredListings && featuredListings.length > 0) { %>
  <div class="pw-featured-grid">
    <% featuredListings.forEach(listing => { %>
      <a class="pw-card pw-featured-card" href="/listings/<%= listing._id %>">
        <img class="pw-featured-image" src="<%= (listing.image && listing.image.url) ? listing.image.url : '/images/placeholder.svg' %>" alt="<%= listing.title %>">
        <div class="pw-featured-info">
          <h3 class="pw-featured-title"><%= listing.title %></h3>
          <p class="pw-featured-location"><i class="fa-solid fa-location-dot"></i> <%= listing.location %>, <%= listing.country %></p>
          <p class="pw-featured-price">&#8377; <%= listing.price.toLocaleString('en-IN') %> <span class="pw-price-unit">per hour</span></p>
        </div>
      </a>
    <% }) %>
  </div>
  <% } else { %>
    <p class="muted">No shifts are live yet. Post the first peak-hour request.</p>
  <% } %>
</section>

<section id="how-it-works" class="pw-section pw-section-soft">
  <h2 class="pw-heading pw-heading-sm pw-center">How PeakShift Works</h2>
  <div class="pw-steps-grid">
    <div class="pw-card pw-step-card">
      <div class="pw-step-number">1</div>
      <h3>Create a shift</h3>
      <p class="muted">Businesses post role, location, pay, timing, and worker count for a short demand spike.</p>
    </div>
    <div class="pw-card pw-step-card">
      <div class="pw-step-number">2</div>
      <h3>Match verified workers</h3>
      <p class="muted">Workers discover nearby opportunities by availability, skill tags, and trust history.</p>
    </div>
    <div class="pw-card pw-step-card">
      <div class="pw-step-number">3</div>
      <h3>Check in and get paid</h3>
      <p class="muted">Workers check in for their shift and get rated on completion, building trust for future matches</p>
    </div>
  </div>
</section>

<section id="categories" class="pw-section">
  <h2 class="pw-heading pw-heading-sm pw-center">Built for recurring local rushes</h2>
  <div class="pw-market-grid">
    <div class="pw-market-tile"><i class="fa-solid fa-utensils"></i><span>Restaurants and QSRs</span></div>
    <div class="pw-market-tile"><i class="fa-solid fa-kitchen-set"></i><span>Cloud kitchens</span></div>
    <div class="pw-market-tile"><i class="fa-solid fa-bag-shopping"></i><span>Retail stores</span></div>
    <div class="pw-market-tile"><i class="fa-solid fa-prescription-bottle-medical"></i><span>Pharmacies</span></div>
    <div class="pw-market-tile"><i class="fa-solid fa-film"></i><span>Multiplex cinemas</span></div>
    <div class="pw-market-tile"><i class="fa-solid fa-calendar-day"></i><span>Events</span></div>
  </div>
</section>

<% if (topReviews && topReviews.length > 0) { %>
<section class="pw-section pw-section-soft">
  <h2 class="pw-heading pw-heading-sm pw-center">What People Are Saying</h2>
  <div class="pw-review-grid">
    <% topReviews.forEach(review => { %>
      <div class="pw-card pw-review-card">
        <div class="pw-review-stars">
          <% for (let s = 0; s < review.rating; s++) { %><i class="fa-solid fa-star"></i><% } %>
        </div>
        <p class="pw-review-quote">&ldquo;<%= review.comment %>&rdquo;</p>
        <p class="pw-review-meta">&mdash; <%= review.author %>, on <%= review.listingTitle %></p>
      </div>
    <% }) %>
  </div>
</section>
<% } %>
