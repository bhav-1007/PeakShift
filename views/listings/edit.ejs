<% layout('layouts/boilerplate') %>

<section class="py-2">
  <div class="row">
    <div class="col-lg-8 offset-lg-2">
      <div class="form-panel shadow-sm">
        <h1>Edit Shift Request</h1>

        <% if (listing.filledCount > 0) { %>
          <div class="alert alert-warning" style="border-radius: var(--radius); margin-bottom: 20px;">
            <i class="fa-solid fa-lock me-2"></i>
            <strong>Edit Lock Active:</strong> <%= listing.filledCount %> worker<%= listing.filledCount > 1 ? "s have" : " has" %> already accepted this shift. Title, timing, slots, and location are locked. Only the shift details/description can be edited.
          </div>
        <% } %>

        <form method="POST" action="/listings/<%= listing._id %>?_method=PUT">
          <div>
            <label for="title">Shift title</label>
            <input type="text" id="title" name="listing[title]" value="<%= listing.title %>" placeholder="Cloud kitchen dinner rush" required <%= listing.filledCount > 0 ? 'disabled' : '' %>>
          </div>

          <div>
            <label for="description">Shift details</label>
            <textarea id="description" name="listing[description]" placeholder="Describe the work, reporting instructions, required experience, and payout details." required><%= listing.description %></textarea>
          </div>

          <div>
            <label for="roleType">Role type</label>
            <input type="text" id="roleType" name="listing[roleType]" value="<%= listing.roleType || '' %>" placeholder="Packer, helper cook, cashier, event crew" <%= listing.filledCount > 0 ? 'disabled' : '' %>>
          </div>

          <div class="booking-date-grid">
            <div>
              <label for="workersNeeded">Workers needed (slots)</label>
              <input type="number" id="workersNeeded" name="listing[workersNeeded]" value="<%= listing.workersNeeded || 1 %>" required min="1" <%= listing.filledCount > 0 ? 'disabled' : '' %>>
            </div>
            <div>
              <label for="skillTags">Skill tags</label>
              <input type="text" id="skillTags" name="listing[skillTags]" value="<%= listing.skillTags ? listing.skillTags.join(', ') : '' %>" placeholder="packing, POS, cleaning" <%= listing.filledCount > 0 ? 'disabled' : '' %>>
            </div>
          </div>

          <div class="booking-date-grid">
            <div>
              <label for="startAt">Shift start time (IST)</label>
              <input type="datetime-local" id="startAt" name="listing[startAt]" value="<%= timeHelpers.formatForDateTimeLocal(listing.startAt) %>" required <%= listing.filledCount > 0 ? 'disabled' : '' %>>
            </div>
            <div>
              <label for="endAt">Shift end time (IST)</label>
              <input type="datetime-local" id="endAt" name="listing[endAt]" value="<%= timeHelpers.formatForDateTimeLocal(listing.endAt) %>" required <%= listing.filledCount > 0 ? 'disabled' : '' %>>
            </div>
          </div>



          <div>
            <label for="price">Hourly pay (&#8377;)</label>
            <input type="number" id="price" name="listing[price]" value="<%= listing.price %>" placeholder="150" required min="0" <%= listing.filledCount > 0 ? 'disabled' : '' %>>
          </div>

          <div style="position:relative;">
            <label for="location-search">Location</label>
            <input type="text" id="location-search" value="<%= listing.location %>" placeholder="Start typing an address or city..." autocomplete="off" required <%= listing.filledCount > 0 ? 'disabled' : '' %>>
            <div id="suggestions" class="location-suggestions"></div>
            <p class="muted" id="location-confirm" style="margin-top:6px; display:none;">
              <i class="fa-solid fa-circle-check"></i> Location confirmed: <span id="location-confirm-text"></span>
            </p>
          </div>

          <!-- Hidden fields actually submitted to the server -->
          <input type="hidden" id="location" name="listing[location]" value="<%= listing.location %>">
          <input type="hidden" id="lat" name="listing[lat]" value="<%= listing.geometry && listing.geometry.coordinates ? listing.geometry.coordinates[1] : '' %>">
          <input type="hidden" id="lng" name="listing[lng]" value="<%= listing.geometry && listing.geometry.coordinates ? listing.geometry.coordinates[0] : '' %>">

          <div class="col-12" style="margin-top:16px;">
            <button class="btn btn-primary" type="submit">Update Shift Request</button>
            <a class="btn danger ms-2" href="/listings/<%= listing._id %>">Cancel</a>
          </div>
        </form>
      </div>
    </div>
  </div>
</section>

<% if (listing.filledCount === 0) { %>
<script>
  (function () {
    const searchInput = document.getElementById('location-search');
    const suggestionsBox = document.getElementById('suggestions');
    const locationInput = document.getElementById('location');
    const latInput = document.getElementById('lat');
    const lngInput = document.getElementById('lng');
    const confirmMsg = document.getElementById('location-confirm');
    const confirmText = document.getElementById('location-confirm-text');

    let debounceTimer;

    searchInput.addEventListener('input', () => {
      confirmMsg.style.display = 'none';

      clearTimeout(debounceTimer);
      const query = searchInput.value.trim();
      if (query.length < 3) {
        suggestionsBox.innerHTML = '';
        return;
      }

      debounceTimer = setTimeout(async () => {
        try {
          const url = `https://nominatim.openstreetmap.org/search?format=json&addressdetails=1&limit=5&q=${encodeURIComponent(query)}`;
          const res = await fetch(url);
          const data = await res.json();
          renderSuggestions(data);
        } catch (err) {
          suggestionsBox.innerHTML = '<div class="suggestion-item muted">Search failed, try again.</div>';
        }
      }, 400);
    });

    function renderSuggestions(results) {
      suggestionsBox.innerHTML = '';
      if (!results.length) {
        suggestionsBox.innerHTML = '<div class="suggestion-item muted">No matches found.</div>';
        return;
      }
      results.forEach((place) => {
        const item = document.createElement('div');
        item.className = 'suggestion-item';
        item.textContent = place.display_name;
        item.addEventListener('click', () => {
          searchInput.value = place.display_name;
          locationInput.value = place.display_name;
          latInput.value = place.lat;
          lngInput.value = place.lon;
          suggestionsBox.innerHTML = '';
          confirmText.textContent = place.display_name;
          confirmMsg.style.display = 'block';
        });
        suggestionsBox.appendChild(item);
      });
    }

    document.addEventListener('click', (e) => {
      if (!suggestionsBox.contains(e.target) && e.target !== searchInput) {
        suggestionsBox.innerHTML = '';
      }
    });

    searchInput.closest('form').addEventListener('submit', (e) => {
      if (!locationInput.value) {
        locationInput.value = searchInput.value.trim();
      }
    });
  })();
</script>
<% } %>
