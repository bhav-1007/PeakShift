<% layout('layouts/boilerplate') %>

<div class="page-heading">
    <div class="page-heading-header">
        <div>
            <h1>Open Peak Shifts</h1>
            <p class="muted mb-0">Short, upcoming shifts near you. Apply before slots fill up.</p>
        </div>
        <div>
            <button
                type="button"
                id="near-me-btn"
                class="btn"
                style="background: var(--accent-coral, #f43f5e); color: white;"
                data-has-home="<%= (currentUser && currentUser.geometry && currentUser.geometry.coordinates) ? 'true' : 'false' %>"
                data-home-lat="<%= (currentUser && currentUser.geometry && currentUser.geometry.coordinates) ? currentUser.geometry.coordinates[1] : '' %>"
                data-home-lng="<%= (currentUser && currentUser.geometry && currentUser.geometry.coordinates) ? currentUser.geometry.coordinates[0] : '' %>"
            >
                <i class="fa-solid fa-location-crosshairs me-1"></i> Near me
            </button>
        </div>
    </div>

    <!-- Geolocation feedback alert -->
    <div id="geo-message" class="alert alert-warning mb-0" style="display:none; border-radius: var(--radius);"></div>

    <!-- Filters Form -->
    <div class="filter-form-wrap">
        <form id="filter-form" method="GET" action="/listings">
            <div class="filter-grid">
                <div>
                    <label for="q"><i class="fa-solid fa-magnifying-glass me-1 text-primary"></i> Search</label>
                    <input type="text" id="q" name="q" placeholder="Role, business, or location" value="<%= query.q || '' %>">
                </div>
                <div>
                    <label for="skill"><i class="fa-solid fa-tag me-1 text-primary"></i> Skill</label>
                    <input type="text" id="skill" name="skill" placeholder="e.g. packing, counter" value="<%= query.skill || '' %>">
                </div>
                <div>
                    <label for="minPrice"><i class="fa-solid fa-indian-rupee-sign me-1 text-primary"></i> Min pay</label>
                    <input type="number" id="minPrice" name="minPrice" placeholder="0" min="0" value="<%= query.minPrice || '' %>">
                </div>
                <div>
                    <label for="filter-when"><i class="fa-regular fa-clock me-1 text-primary"></i> When</label>
                    <select id="filter-when" name="when">
                        <option value="" <%= !query.when ? 'selected' : '' %>>All upcoming</option>
                        <option value="next2h" <%= query.when === 'next2h' ? 'selected' : '' %>>Next 2 hours</option>
                        <option value="today" <%= query.when === 'today' ? 'selected' : '' %>>Today</option>
                        <option value="tomorrow" <%= query.when === 'tomorrow' ? 'selected' : '' %>>Tomorrow</option>
                    </select>
                </div>
                <div>
                    <label for="filter-radius"><i class="fa-solid fa-compass me-1 text-primary"></i> Radius</label>
                    <select id="filter-radius" name="radius">
                        <option value="" <%= !query.radius ? 'selected' : '' %>>Any radius</option>
                        <option value="2" <%= query.radius == '2' ? 'selected' : '' %>>Within 2 km</option>
                        <option value="5" <%= query.radius == '5' ? 'selected' : '' %>>Within 5 km</option>
                        <option value="10" <%= query.radius == '10' ? 'selected' : '' %>>Within 10 km</option>
                        <option value="20" <%= query.radius == '20' ? 'selected' : '' %>>Within 20 km</option>
                    </select>
                </div>
                <div>
                    <label for="filter-sort"><i class="fa-solid fa-arrow-down-short-wide me-1 text-primary"></i> Sort by</label>
                    <select id="filter-sort" name="sort">
                        <option value="soonest" <%= (!query.sort || query.sort === 'soonest') ? 'selected' : '' %>>Soonest</option>
                        <option value="nearest" <%= query.sort === 'nearest' ? 'selected' : '' %>>Nearest</option>
                        <option value="highestPay" <%= query.sort === 'highestPay' ? 'selected' : '' %>>Highest pay</option>
                    </select>
                </div>
                <div class="d-flex gap-2">
                    <button class="btn btn-primary flex-grow-1" type="submit">Filter</button>
                    <a class="btn btn-secondary" href="/listings">Reset</a>
                </div>
            </div>

            <!-- Hidden coordinates passed from Near me or previous search -->
            <input type="hidden" id="filter-lat" name="lat" value="<%= query.lat || '' %>">
            <input type="hidden" id="filter-lng" name="lng" value="<%= query.lng || '' %>">
        </form>
    </div>
</div>

<% if (allListings && allListings.length > 0) { %>
    <ul class="shift-list">
        <% allListings.forEach(listing => { %>
            <%- include('../includes/shift-card', { listing, timeHelpers }) %>
        <% }) %>
    </ul>

    <% if (totalPages > 1) { %>
        <div class="actions" style="justify-content:center; border-top:none; margin-top:30px;">
            <% for (let p = 1; p <= totalPages; p++) { %>
                <a class="btn <%= p === currentPage ? '' : 'danger' %>"
                   style=<%= p === currentPage ? '' : 'background:var(--surface); color:var(--ink); box-shadow:3px 3px 0 var(--ink);' %>
                   href="/listings?<%= new URLSearchParams({ ...query, page: p }).toString() %>">
                    <%= p %>
                </a>
            <% } %>
        </div>
    <% } %>
<% } else { %>
    <%- include('../includes/empty-state', {
        icon: 'fa-solid fa-calendar-xmark',
        title: 'No open shifts found',
        message: 'There are currently no open upcoming shifts matching your search filters.',
        actionText: 'Clear filters',
        actionLink: '/listings'
    }) %>
<% } %>

<script>
  (function () {
    const nearMeBtn = document.getElementById('near-me-btn');
    const geoMsg = document.getElementById('geo-message');
    const latInput = document.getElementById('filter-lat');
    const lngInput = document.getElementById('filter-lng');
    const sortSelect = document.getElementById('filter-sort');
    const radiusSelect = document.getElementById('filter-radius');
    const filterForm = document.getElementById('filter-form');

    if (!nearMeBtn) return;

    function showMessage(msg, isInfo) {
      if (!geoMsg) return;
      geoMsg.className = isInfo ? 'alert alert-info mt-3' : 'alert alert-warning mt-3';
      geoMsg.innerHTML = `<i class="fa-solid ${isInfo ? 'fa-circle-info' : 'fa-triangle-exclamation'} me-2"></i>${msg}`;
      geoMsg.style.display = 'block';
    }

    function applyCoordsAndSubmit(lat, lng, note) {
      latInput.value = lat;
      lngInput.value = lng;
      if (sortSelect) sortSelect.value = 'nearest';
      if (radiusSelect && !radiusSelect.value) radiusSelect.value = '20';

      if (note) {
        showMessage(note, true);
        setTimeout(() => filterForm.submit(), 600);
      } else {
        filterForm.submit();
      }
    }

    function handleFallback(reason) {
      const hasHome = nearMeBtn.getAttribute('data-has-home') === 'true';
      const homeLat = nearMeBtn.getAttribute('data-home-lat');
      const homeLng = nearMeBtn.getAttribute('data-home-lng');

      if (hasHome && homeLat && homeLng) {
        applyCoordsAndSubmit(homeLat, homeLng, `${reason} Using your saved home location instead.`);
      } else {
        showMessage(`${reason} Please allow location access or set your home location in your worker profile.`);
      }
    }

    nearMeBtn.addEventListener('click', () => {
      geoMsg.style.display = 'none';

      if (!navigator.geolocation) {
        handleFallback('Browser geolocation is not supported.');
        return;
      }

      nearMeBtn.disabled = true;
      const originalText = nearMeBtn.innerHTML;
      nearMeBtn.innerHTML = '<i class="fa-solid fa-spinner fa-spin me-1"></i> Locating...';

      navigator.geolocation.getCurrentPosition(
        (position) => {
          nearMeBtn.disabled = false;
          nearMeBtn.innerHTML = originalText;
          applyCoordsAndSubmit(position.coords.latitude, position.coords.longitude);
        },
        (error) => {
          nearMeBtn.disabled = false;
          nearMeBtn.innerHTML = originalText;
          let reason = 'Location permission denied.';
          if (error.code === error.TIMEOUT) {
            reason = 'Location request timed out.';
          } else if (error.code === error.POSITION_UNAVAILABLE) {
            reason = 'Location position unavailable.';
          }
          handleFallback(reason);
        },
        { timeout: 8000 }
      );
    });
  })();
</script>
