<% layout('layouts/boilerplate') %>

<div class="page-heading">
    <div>
        <h1>My Shift Requests</h1>
        <p>All peak-hour staffing requests posted by your business.</p>
    </div>
    <a class="btn" href="/listings/new">Post Shift</a>
</div>

<% if (myListings && myListings.length > 0) { %>
    <ul class="shift-list">
        <% myListings.forEach(listing => { %>
            <%- include('../includes/shift-card', { listing, timeHelpers }) %>
        <% }) %>
    </ul>
<% } else { %>
    <%- include('../includes/empty-state', {
        icon: 'fa-solid fa-briefcase',
        title: 'No shift requests yet',
        message: 'You have not posted any shifts yet. Post your first shift to recruit verified workers for peak hours.',
        actionText: 'Post a shift',
        actionLink: '/listings/new'
    }) %>
<% } %>
