<% layout('layouts/boilerplate') %>

<article>
    <div class="show-page">

        <!-- Main Details Column -->
        <div class="show-main">
            <div class="card p-4 shadow-sm" style="background:var(--surface); border:1px solid var(--line); border-radius:var(--radius-lg);">
                <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
                    <div class="d-flex align-items-center gap-2">
                        <span class="badge bg-primary-subtle text-primary border" style="font-size:0.85rem; padding:6px 12px;">
                            <i class="fa-solid fa-briefcase me-1"></i><%= listing.roleType || "Peak-hour helper" %>
                        </span>
                        <span class="shift-badge-time" style="background:var(--brand-light); color:var(--brand-dark); font-size:0.8rem; padding:6px 12px; border-radius:var(--radius-pill);">
                            <i class="fa-solid fa-clock me-1"></i><%= timeHelpers.formatStartsIn(listing.startAt) %>
                        </span>
                    </div>

                    <% if (listing.status === 'cancelled') { %>
                        <span class="badge bg-danger" style="font-size:0.85rem; padding:6px 12px;">Cancelled</span>
                    <% } else if (listing.status === 'filled') { %>
                        <span class="badge bg-secondary" style="font-size:0.85rem; padding:6px 12px;">Fully Staffed</span>
                    <% } else { %>
                        <span class="badge bg-success-subtle text-success-emphasis border" style="font-size:0.85rem; padding:6px 12px;">
                            <i class="fa-solid fa-circle-dot me-1"></i>Open for Booking
                        </span>
                    <% } %>
                </div>

                <h1 style="font-size:2rem; font-weight:800; color:var(--ink); margin-bottom:16px; line-height:1.25;">
                    <%= listing.title %>
                </h1>

                <% if (listing.status === 'cancelled') { %>
                    <div class="alert alert-danger d-flex align-items-center gap-2" style="border-radius:var(--radius); margin:16px 0;">
                        <i class="fa-solid fa-ban fs-5"></i>
                        <div>
                            <strong>This shift has been cancelled.</strong>
                            <div class="small">No further worker bookings or check-ins can occur for this posting.</div>
                        </div>
                    </div>
                <% } %>

                <!-- Shift Metrics Banner -->
                <div class="p-3 mb-4 rounded d-flex flex-wrap justify-content-between align-items-center gap-3" style="background:var(--surface-soft); border:1px solid var(--line);">
                    <div>
                        <span class="small text-muted d-block mb-1"><i class="fa-regular fa-calendar-days text-primary me-1"></i>Date & Schedule</span>
                        <strong style="font-size:0.95rem; color:var(--ink);"><%= timeHelpers.formatShiftRangeIST(listing.startAt, listing.endAt) %></strong>
                    </div>
                    <div>
                        <span class="small text-muted d-block mb-1"><i class="fa-solid fa-hourglass-half text-primary me-1"></i>Duration</span>
                        <strong style="font-size:0.95rem; color:var(--ink);"><%= timeHelpers.calculateHours(listing.startAt, listing.endAt) %> Hours</strong>
                    </div>
                    <div>
                        <span class="small text-muted d-block mb-1"><i class="fa-solid fa-location-dot text-primary me-1"></i>Location</span>
                        <strong style="font-size:0.95rem; color:var(--ink);"><%= listing.location %></strong>
                    </div>
                    <div>
                        <span class="small text-muted d-block mb-1"><i class="fa-solid fa-users text-primary me-1"></i>Roster Staffing</span>
                        <strong style="font-size:0.95rem; color:var(--ink);"><%= listing.filledCount %> / <%= listing.workersNeeded %> slots filled</strong>
                    </div>
                </div>

                <!-- Shift Capacity Meter -->
                <% const capacityPct = Math.min(100, Math.round((listing.filledCount / listing.workersNeeded) * 100)); %>
                <div class="mb-4">
                    <div class="d-flex justify-content-between align-items-center small mb-1">
                        <span class="text-muted fw-semibold">Staffing Capacity</span>
                        <span class="fw-bold text-dark"><%= listing.filledCount %> of <%= listing.workersNeeded %> confirmed (<%= capacityPct %>%)</span>
                    </div>
                    <div class="shift-progress-track">
                        <div class="shift-progress-bar <%= capacityPct >= 100 ? 'bg-secondary' : 'bg-primary' %>" style="width:<%= capacityPct %>%;"></div>
                    </div>
                </div>

                <!-- Description / Overview -->
                <div class="mb-4">
                    <h3 style="font-size:1.1rem; font-weight:700; color:var(--ink); margin-bottom:10px;">
                        <i class="fa-solid fa-circle-info text-primary me-2"></i>Shift Description & Requirements
                    </h3>
                    <p class="description mb-0" style="font-size:1rem; line-height:1.7; color:var(--ink-secondary, #334155);">
                        <%= listing.description %>
                    </p>
                </div>

                <!-- Skills & Tags -->
                <% if (listing.skillTags && listing.skillTags.length > 0) { %>
                    <div class="mb-3">
                        <h4 style="font-size:0.85rem; font-weight:700; text-transform:uppercase; letter-spacing:0.04em; color:var(--text-soft); margin-bottom:10px;">
                            Required Skills
                        </h4>
                        <div class="listing-card-tags">
                            <% listing.skillTags.forEach(tag => { %>
                                <span><i class="fa-solid fa-tag text-primary"></i> <%= tag %></span>
                            <% }) %>
                        </div>
                    </div>
                <% } %>

                <!-- Accepted Worker Roster (For Host Only) -->
                <% if (currentUser && listing.owner && listing.owner._id.equals(currentUser._id)) { %>
                    <% if (typeof acceptedBookings !== 'undefined' && acceptedBookings && acceptedBookings.length > 0) { %>
                        <div class="mt-4 pt-4 border-top">
                            <div class="d-flex justify-content-between align-items-center mb-3">
                                <h4 style="font-size:1.1rem; font-weight:700; margin:0;">
                                    <i class="fa-solid fa-clipboard-user text-primary me-2"></i>Confirmed Workers (<%= acceptedBookings.length %>)
                                </h4>
                                <a href="/dashboard" class="btn btn-secondary btn-sm">
                                    <i class="fa-solid fa-gauge me-1"></i> Business Dashboard
                                </a>
                            </div>
                            <ul class="list-group shadow-sm" style="border-radius:var(--radius); overflow:hidden;">
                                <% acceptedBookings.forEach(booking => { %>
                                    <li class="list-group-item d-flex justify-content-between align-items-center p-3">
                                        <div class="d-flex align-items-center gap-3">
                                            <div class="rounded-circle bg-primary-subtle text-primary fw-bold d-flex align-items-center justify-content-center" style="width:40px; height:40px;">
                                                <i class="fa-solid fa-user"></i>
                                            </div>
                                            <div>
                                                <strong class="d-block" style="font-size:0.95rem;"><%= booking.worker ? booking.worker.username : 'Worker' %></strong>
                                                <span class="muted small d-block">
                                                    <i class="fa-solid fa-id-card-clip text-primary me-1"></i>Worker Pass: #<%= booking.worker ? booking.worker._id.toString().slice(-6).toUpperCase() : 'N/A' %>
                                                    <% if (booking.worker && booking.worker.phone) { %>
                                                        &bull; Phone: <%= booking.worker.phone %>
                                                    <% } %>
                                                </span>
                                            </div>
                                        </div>
                                        <div class="text-end">
                                            <%- include('../includes/status-badge', { status: booking.status }) %>
                                        </div>
                                    </li>
                                <% }) %>
                            </ul>
                        </div>
                    <% } %>
                <% } %>
            </div>
        </div>

        <!-- Sidebar Column -->
        <div class="show-sidebar d-flex flex-column gap-3">

            <!-- Pay & Booking Action Card -->
            <div class="card p-4 shadow-sm" style="background:var(--surface); border:1px solid var(--line); border-radius:var(--radius-lg);">
                <div class="d-flex justify-content-between align-items-baseline mb-2">
                    <div>
                        <span class="text-muted small d-block">Pay Rate</span>
                        <span style="font-size:2rem; font-weight:800; color:var(--ink);">&#8377; <%= listing.price.toLocaleString('en-IN') %></span>
                        <span class="text-muted fw-semibold">/ hr</span>
                    </div>
                    <% const totalPayEst = listing.price * timeHelpers.calculateHours(listing.startAt, listing.endAt); %>
                    <div class="text-end">
                        <span class="text-muted small d-block">Total Est. Pay</span>
                        <span class="text-primary fw-bold" style="font-size:1.2rem;">&#8377; <%= totalPayEst.toLocaleString('en-IN') %></span>
                    </div>
                </div>

                <hr class="my-3" style="border-color:var(--line);">

                <% if (listing.status !== 'cancelled') { %>
                    <%- include("../bookings/new.ejs", { listing }) %>
                <% } else { %>
                    <button class="btn btn-secondary w-100" disabled>Shift Cancelled</button>
                <% } %>

                <% if (currentUser) { %>
                    <form method="POST" action="/listings/<%= listing._id %>/wishlist" class="mt-2 mb-0">
                        <button class="btn btn-secondary w-100 <%= isWishlisted ? 'border-danger text-danger' : '' %>" type="submit">
                            <i class="fa-solid fa-heart me-1 <%= isWishlisted ? 'text-danger' : '' %>"></i>
                            <%= isWishlisted ? " Remove from Watchlist" : " Save to Watchlist" %>
                        </button>
                    </form>
                <% } %>

                <% if (currentUser && listing.owner && listing.owner._id.equals(currentUser._id)) { %>
                    <!-- Host Management Actions -->
                    <div class="mt-3 pt-3 border-top d-grid gap-2">
                        <% if (listing.status !== 'cancelled') { %>
                            <a class="btn btn-secondary w-100" href="/listings/<%= listing._id %>/edit">
                                <i class="fa-solid fa-pen-to-square me-1"></i> <%= listing.filledCount > 0 ? 'Edit Details (Locked)' : 'Edit Shift' %>
                            </a>

                            <button type="button" class="btn btn-outline-danger w-100" data-bs-toggle="modal" data-bs-target="#cancelShiftModal">
                                <i class="fa-solid fa-ban me-1"></i> Cancel Shift
                            </button>

                            <!-- Confirm Modal -->
                            <div class="modal fade" id="cancelShiftModal" tabindex="-1" aria-labelledby="cancelShiftModalLabel" aria-hidden="true">
                                <div class="modal-dialog">
                                    <div class="modal-content">
                                        <div class="modal-header">
                                            <h5 class="modal-title" id="cancelShiftModalLabel">Cancel Shift Request</h5>
                                            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                        </div>
                                        <div class="modal-body">
                                            <p>Are you sure you want to cancel <strong><%= listing.title %></strong>?</p>
                                            <p class="text-danger small mb-0">This will mark the shift as cancelled and cancel all accepted worker slots.</p>
                                        </div>
                                        <div class="modal-footer">
                                            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Keep Shift</button>
                                            <form method="POST" action="/listings/<%= listing._id %>/cancel" style="margin:0;">
                                                <button class="btn danger" type="submit">Yes, Cancel Shift</button>
                                            </form>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        <% } %>
                    </div>
                <% } %>
            </div>

            <!-- Host Trust Card -->
            <% if (listing.owner) { %>
            <div class="card p-3 shadow-sm" style="background:var(--surface); border:1px solid var(--line); border-radius:var(--radius-lg);">
                <div class="d-flex justify-content-between align-items-center mb-2">
                    <span class="small fw-bold text-muted text-uppercase" style="letter-spacing:0.04em;">Host Business</span>
                    <span class="badge bg-primary-subtle text-primary border" title="Business Trust Score">
                        <i class="fa-solid fa-shield-halved me-1"></i>Trust: <strong><%= listing.owner.trustScore != null ? listing.owner.trustScore : 70 %></strong>/100
                    </span>
                </div>
                <div class="d-flex align-items-center gap-3">
                    <div class="rounded-circle bg-primary text-white d-flex align-items-center justify-content-center shadow-sm" style="width:44px; height:44px; font-weight:800; font-size:1.1rem; flex-shrink:0;">
                        <%= (listing.owner.businessName || listing.owner.username).charAt(0).toUpperCase() %>
                    </div>
                    <div>
                        <strong class="d-block" style="font-size:1rem; color:var(--ink);"><%= listing.owner.businessName || listing.owner.username %></strong>
                        <span class="text-success small fw-semibold">
                            <i class="fa-solid fa-circle-check me-1"></i>Verified Host
                        </span>
                        <div class="small text-muted mt-1">
                            <i class="fa-solid fa-star text-warning"></i>
                            <strong><%= listing.owner.ratingCount > 0 ? (listing.owner.ratingAvg.toFixed(1) + " / 5 (" + listing.owner.ratingCount + ")") : "New Host" %></strong>
                        </div>
                    </div>
                </div>
            </div>
            <% } %>

            <!-- Interactive Location Map Card -->
            <% if (listing.geometry && listing.geometry.coordinates && listing.geometry.coordinates.length === 2) { %>
            <div class="card p-3 shadow-sm" style="background:var(--surface); border:1px solid var(--line); border-radius:var(--radius-lg);">
                <div class="d-flex justify-content-between align-items-center mb-2">
                    <h3 style="margin:0; font-size:1rem; font-weight:700;">
                        <i class="fa-solid fa-location-dot text-primary me-2"></i>Shift Location
                    </h3>
                    <span class="text-muted small"><%= listing.location %></span>
                </div>
                <div id="map" style="height:240px; border-radius:var(--radius); border:1px solid var(--line); overflow:hidden;"></div>
            </div>
            <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css">
            <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
            <script>
                const coords = <%- JSON.stringify(listing.geometry.coordinates) %> ;
                const map = L.map('map').setView([coords[1], coords[0]], 13);
                L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
                    attribution: '&copy; OpenStreetMap contributors',
                }).addTo(map);
                L.marker([coords[1], coords[0]])
                    .addTo(map)
                    .bindPopup("<strong><%= listing.title %></strong><br><%= listing.location %>")
                    .openPopup();
            </script>
            <% } %>

        </div>

    </div>

    <div class="mt-4 pt-2">
        <a class="text-link" href="/listings">
            <i class="fa-solid fa-arrow-left me-1"></i> Back to open shifts
        </a>
    </div>
</article>
