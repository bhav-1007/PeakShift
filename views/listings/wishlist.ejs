<% layout('layouts/boilerplate') %>

<div class="page-heading">
    <div>
        <h1>Watchlist</h1>
        <p>Shifts you saved for later.</p>
    </div>
</div>

<% if (wishlistListings.length > 0) { %>
    <ul class="shift-list">
        <% wishlistListings.forEach(listing => { %>
            <%- include('../includes/shift-card', { listing, timeHelpers }) %>
        <% }) %>
    </ul>
<% } else { %>
    <%- include('../includes/empty-state', {
        icon: 'fa-regular fa-heart',
        title: 'Your watchlist is empty',
        message: 'You have not saved any shifts to your watchlist yet. Browse open shifts and click the heart icon to save them here.',
        actionText: 'Browse open shifts',
        actionLink: '/listings'
    }) %>
<% } %>
