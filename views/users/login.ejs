<% layout('/layouts/boilerplate') %>

<div class="d-flex justify-content-center align-items-center py-4">
  <div class="form-panel shadow-sm" style="max-width: 460px; width:100%; border-radius:var(--radius-xl); padding:36px 32px;">
    <div class="text-center mb-4">
      <div class="brand-mark mx-auto mb-3" style="width:48px; height:48px; font-size:1.3rem;">P</div>
      <h1 style="font-size:1.75rem; font-weight:800; margin-bottom:6px;">Welcome to PeakShift</h1>
      <p class="muted small mb-0">Sign in to access your worker pass or business operations.</p>
    </div>

    <form action="/login" method="POST" class="d-grid gap-3">
      <div class="form-group mb-0">
        <label for="username" class="d-flex align-items-center gap-1 mb-1">
          <i class="fa-regular fa-user text-primary"></i> Username
        </label>
        <input type="text" id="username" name="username" placeholder="Enter your username" required autofocus autocomplete="username">
      </div>

      <div class="form-group mb-0">
        <label for="password" class="d-flex align-items-center gap-1 mb-1">
          <i class="fa-solid fa-lock text-primary"></i> Password
        </label>
        <input type="password" id="password" name="password" placeholder="••••••••" required autocomplete="current-password">
      </div>

      <button type="submit" class="btn btn-primary w-100 mt-2" style="min-height:48px; font-size:1rem;">
        Sign In <i class="fa-solid fa-arrow-right ms-1"></i>
      </button>
    </form>

    <div class="text-center mt-4 pt-3 border-top">
      <p class="muted small mb-0">
        New to PeakShift? <a href="/signup" class="text-primary fw-semibold text-decoration-none">Create an account</a>
      </p>
    </div>
  </div>
</div>
